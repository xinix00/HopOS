+// Copyright 2026 HopOS. Same license as the Go runtime.
+//
+// The idle hook's helpers: IdleMayReady (may it ready goroutines), and the
+// sysmon-lite pair NextTimer/RunIdleTimers (no sysmon on tamago).
+
+//go:build tamago
+
+package runtime
+
+import "runtime/goos"
+
+// IdleMayReady reports whether the goos.Idle hook is running in the
+// scheduler's own idle path (findRunnable -> beforeIdle): this M holds a P and
+// is not inside lock2. Only there may the hook make goroutines runnable — a
+// channel send, a mutex unlock with waiters, goready. The hook is also called
+// from semasleep: an M parked without a P, or a mutex waiter with m.locks > 0.
+// There ready/wakep would corrupt the scheduler itself — runqput on a nil P,
+// or a second sleep on the same m.mWaitList node (lock_spinbit.go).
+func IdleMayReady() bool {
+	gp := getg()
+	return gp.m.p != 0 && gp.m.locks == 0
+}
+
+// NextTimer is the earliest timer over all Ps (0 = none), for the idle hook
+// (goos.Idle): an M that sleeps must not sleep past a timer that lives on an
+// idle P — on tamago there is no sysmon to wake an M for it. Only the P-holding
+// M of the scheduler idle path may call this (it needs no lock: allp changes
+// only in procresize, under a stop-the-world that waits for this M first).
+func NextTimer() int64 {
+	var min int64
+	for _, pp := range allp {
+		if pp == nil {
+			continue
+		}
+		if w := pp.timers.wakeTime(); w != 0 && (min == 0 || w < min) {
+			min = w
+		}
+	}
+	return min
+}
+
+// RunIdleTimers is the sysmon-lite of the idle hook. For every other P with a
+// due timer: an idle P (no M) has its timers run here, the way stealWork does
+// on its last steal try — the readied goroutines land on the caller's P; a P
+// whose M sleeps on the idle hook gets that M kicked (goos.Wake), because the
+// timer may have been modified after the M chose its wake time (a goroutine
+// that migrated resets its cached sleep timer where it lives, on the old P —
+// time.Sleep on P_A, heap on P_B, and P_B's M slept 4.8 s past it, measured
+// 04-09 on a 2-core app), and the caller often may not steal (the spinning
+// limit). Reports what happened and the nanotime it used. Same calling rules
+// as NextTimer; otherwise it does nothing.
+func RunIdleTimers() (ran, kicked bool, now int64) {
+	gp := getg()
+	if gp.m.p == 0 || gp.m.locks != 0 {
+		return false, false, 0
+	}
+	own := gp.m.p.ptr()
+	now = nanotime()
+	for _, pp := range allp {
+		if pp == nil || pp == own {
+			continue
+		}
+		if w := pp.timers.wakeTime(); w == 0 || w > now {
+			continue
+		}
+		if pp.status == _Pidle {
+			if _, _, r := pp.timers.check(now, nil); r {
+				ran = true
+			}
+			continue
+		}
+		if mp := pp.m.ptr(); mp != nil && mp != gp.m && goos.Wake != nil {
+			goos.Wake(mp.procid)
+			kicked = true
+		}
+	}
+	return ran, kicked, now
+}
