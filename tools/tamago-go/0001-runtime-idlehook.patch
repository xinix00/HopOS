+// preemptM is supported in the sense that matters on bare metal: it wakes
+// the target M's core (goos.Wake, the same hook semawakeup uses), so an M that
+// went idle in goos.Idle comes back to the scheduler and reaches the
+// cooperative safepoint the preemption asks for — a stop-the-world must not
+// wait forever on a core that sleeps. There is no async preemption: nothing
+// interrupts a running M mid-instruction, exactly as before.
+const preemptMSupported = true
+
+func preemptM(mp *m) {
+	if goos.Wake != nil {
+		goos.Wake(mp.procid)
+	}
+}
 
