@@ -0,0 +1,145 @@
+// Copyright 2026 HopOS. Same license as the Go runtime.
+
+//go:build tamago
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"runtime/goos"
+	"unsafe"
+)
+
+// WakeSleeper makes gp's pending time.Sleep expire now. It is the lock-correct
+// form of WakeG: the same effect (the goroutine's cached sleep timer fires at
+// the owning P's next timer check), but through the timer's own lock, so it
+// is safe from any M — an idle hook (goos.Idle) on a second core while the
+// first one runs the scheduler, or an M that has released its P (semasleep
+// during a stop-the-world). WakeG rewrites the heap without locks, which is
+// fine on the single core tamago was designed for and corrupts the heap on
+// two (a heaped timer without a heap, measured on Apple M4, 2026-09-03); a
+// goready-based wake needs a P and the semasleep caller has none.
+//
+// woken reports whether a sleep was pending. Not pending — no timer yet,
+// already fired (when == 0), or stopped (zombie) — means gp is not parked in a
+// sleep, and then nothing is touched: readying a goroutine that is not waiting
+// is fatal, and a sleep that has parked but not yet armed its timer
+// (resetForSleep) is simply woken by a later call.
+//
+// remote reports that the timer belongs to a P whose M is another core, and
+// that core has been kicked: the caller's own scheduler will not run the
+// sleeper, so an idle caller should go to sleep rather than return to its
+// scheduler and find nothing — which it would do again and again, kicking the
+// other core each time (319k wakes/s measured on a 2-core app, M4 04-09).
+func WakeSleeper(gp uint) (woken, remote bool) {
+	gp0 := (*g)(unsafe.Pointer(uintptr(gp)))
+	t := gp0.timer
+	if t == nil {
+		return false, false
+	}
+	t.lock()
+	if t.state&timerHeaped == 0 || t.state&timerZombie != 0 || t.when == 0 {
+		t.unlock()
+		return false, false
+	}
+	// The heaped branch of (*timer).modify, with when = 1: mark modified and
+	// lower the heap's minWhenModified so adjust re-sorts and run fires it.
+	t.when = 1
+	t.state |= timerModified
+	ts := t.ts
+	if min := ts.minWhenModified.Load(); min == 0 || min > 1 {
+		// Force timerModified out to t.astate before updating
+		// minWhenModified, to synchronize with ts.adjust (see modify).
+		t.astate.Store(t.state)
+		ts.updateMinWhenModified(1)
+	}
+	t.unlock()
+	// The heap belongs to a P; if that P's M is idle on another core it has
+	// to come back to run the timer — the same wake the scheduler gives a
+	// parked M (semawakeup → goos.Wake). A fake (synctest) timer has no P.
+	if !t.isFake && goos.Wake != nil {
+		var pp *p
+		pp = (*p)(unsafe.Pointer(uintptr(unsafe.Pointer(ts)) - unsafe.Offsetof(pp.timers)))
+		if mp := pp.m.ptr(); mp != nil && mp != getg().m {
+			goos.Wake(mp.procid)
+			remote = true
+		} else if mp == nil {
+			WakeSleeperIdleP.Add(1) // timer op een P zonder M: de eigen scheduler steelt hem
+		} else {
+			WakeSleeperSelf.Add(1)
+		}
+	}
+	return true, remote
+}
+
+// WakeSleeperIdleP/WakeSleeperSelf: telemetrie voor de lokale gevallen (04-09).
+var WakeSleeperIdleP, WakeSleeperSelf atomic.Uint64
+
+
+// IdleMayReady reports whether the goos.Idle hook is running in the
+// scheduler's own idle path (findRunnable -> beforeIdle): this M holds a P and
+// is not inside lock2. Only there may the hook make goroutines runnable — a
+// channel send, a mutex unlock with waiters, goready. The hook is also called
+// from semasleep: an M parked without a P, or a mutex waiter with m.locks > 0.
+// There ready/wakep would corrupt the scheduler itself — runqput on a nil P,
+// or a second sleep on the same m.mWaitList node (lock_spinbit.go).
+func IdleMayReady() bool {
+	gp := getg()
+	return gp.m.p != 0 && gp.m.locks == 0
+}
+
+// NextTimer is the earliest timer over all Ps (0 = none), for the idle hook
+// (goos.Idle): an M that sleeps must not sleep past a timer that lives on an
+// idle P — on tamago there is no sysmon to wake an M for it. Only the P-holding
+// M of the scheduler idle path may call this (it needs no lock: allp changes
+// only in procresize, under a stop-the-world that waits for this M first).
+func NextTimer() int64 {
+	var min int64
+	for _, pp := range allp {
+		if pp == nil {
+			continue
+		}
+		if w := pp.timers.wakeTime(); w != 0 && (min == 0 || w < min) {
+			min = w
+		}
+	}
+	return min
+}
+
+// RunIdleTimers is the sysmon-lite of the idle hook. For every other P with a
+// due timer: an idle P (no M) has its timers run here, the way stealWork does
+// on its last steal try — the readied goroutines land on the caller's P; a P
+// whose M sleeps on the idle hook gets that M kicked (goos.Wake), because the
+// timer may have been modified after the M chose its wake time (a goroutine
+// that migrated resets its cached sleep timer where it lives, on the old P —
+// time.Sleep on P_A, heap on P_B, and P_B's M slept 4.8 s past it, measured
+// 04-09 on a 2-core app), and the caller often may not steal (the spinning
+// limit). Reports what happened and the nanotime it used. Same calling rules
+// as NextTimer; otherwise it does nothing.
+func RunIdleTimers() (ran, kicked bool, now int64) {
+	gp := getg()
+	if gp.m.p == 0 || gp.m.locks != 0 {
+		return false, false, 0
+	}
+	own := gp.m.p.ptr()
+	now = nanotime()
+	for _, pp := range allp {
+		if pp == nil || pp == own {
+			continue
+		}
+		if w := pp.timers.wakeTime(); w == 0 || w > now {
+			continue
+		}
+		if pp.status == _Pidle {
+			if _, _, r := pp.timers.check(now, nil); r {
+				ran = true
+			}
+			continue
+		}
+		if mp := pp.m.ptr(); mp != nil && mp != gp.m && goos.Wake != nil {
+			goos.Wake(mp.procid)
+			kicked = true
+		}
+	}
+	return ran, kicked, now
+}
