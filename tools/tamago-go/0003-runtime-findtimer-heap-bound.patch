diff --git a/src/runtime/sys_tamago_arm64.s b/src/runtime/sys_tamago_arm64.s
index 1654c1ee..9667f463 100644
--- a/src/runtime/sys_tamago_arm64.s
+++ b/src/runtime/sys_tamago_arm64.s
@@ -82,14 +82,15 @@ TEXT runtime·findTimer(SB),NOSPLIT|NOFRAME,$0-0
 	MOVD	(timers_heap)(R0), R0
 	CMP	$0, R0
 	BEQ	fail
+	MOVD	R0, R4		// heap base: the walk below must not leave the slice
 
 	// g->timer.ts.heap[len-1]
 	ADD	R2, R0, R0
 	B	check
 prev:
 	SUB	$(timerWhen__size), R0
-	CMP	$0, R0
-	BEQ	fail
+	CMP	R4, R0
+	BLO	fail		// below heap[0]: the timer is not in the heap (not sleeping)
 check:
 	// find heap entry matching g.timer
 	MOVD	(timerWhen_timer)(R0), R1
