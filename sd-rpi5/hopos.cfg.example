# HopOS boot-config — VOORBEELD. Kopieer naar hopos.cfg en vul je eigen
# waarden in:
#
#     cp sd-rpi5/hopos.cfg.example sd-rpi5/hopos.cfg
#
# hopos.cfg zelf staat in .gitignore: hij bevat geheimen (hopos.apikey,
# hopos.s3.secret) en hoort nooit in git. Dit voorbeeld staat er wél in, zodat
# een verse clone ziet wát er nodig is — config.txt laadt het bestand namelijk
# verplicht (`initramfs hopos.cfg`), dus zonder hopos.cfg boot de node niet
# zoals bedoeld.
#
# Formaat: één sleutel per regel. Volle jobspec-JSON mag hier (zelfde formaat
# als de HOP-API) — dit bestand komt integraal in RAM, dus het
# 1024-byte-bootargs-plafond van cmdline.txt geldt niet.

# --- Node-identiteit ---------------------------------------------------------
hopos.node=pi5
hopos.cluster=hoplab

# --- API-authenticatie (VERPLICHT op een netwerk-node) -----------------------
# HMAC-sleutel voor de HTTP-API (agent :8080, leader :9080). Zonder deze
# sleutel weigert de node zijn API te starten — een open API betekent dat
# elke host op het LAN jobs kan dispatchen. Genereer er een verse:
#
#     openssl rand -hex 24
#
# Wil je bewust een open API (bank/dev), zet dan hopos.insecure=1 i.p.v. dit.
hopos.apikey=<openssl rand -hex 24>

# --- Optioneel: read-only metal-debug-endpoint op :9091 ----------------------
# Alleen gui-builds, en zónder auth — dus standaard uit. Aanzetten op de
# bring-up-bank, niet in productie.
#hopos.debug=1

# --- Optioneel: HOP-runtime over meerdere cores ------------------------------
# Core 0 telt mee. Wordt geklemd op het aantal fysieke cores van het board.
#hopos.cores=2

# --- S3 (clusterstaat + artifacts) ------------------------------------------
# Leeg laten = vluchtig standalone (geen gecommitte clusterstaat).
hopos.s3.endpoint=https://<jouw-s3-endpoint>
hopos.s3.bucket=<bucket>
hopos.s3.region=<region>
hopos.s3.key=<access-key-id>
hopos.s3.secret=<secret-access-key>
hopos.s3.pathstyle=1

# --- Desktop: de standaard voor GUI/headful nodes ----------------------------
# display + launcher ZIJN de desktop; ze delen ÉÉN core via de "desktop"-
# sharegroup (meest-idle UI-chrome), zodat elke andere core vrij blijft voor
# echte apps. De URL's zijn live (SURF rolling-release) — werkt as-is.
# Een *-headless node heeft geen GUI: laat dit hele desktop-blok weg en zet
# alleen de hopos.init[]-apps neer die de node moet draaien.
# LET OP: met hopos.apikey gezet moet de launcher óók "HOP_KEY":"<zelfde-key>"
# in zijn env krijgen (hij POST de catalogus-job naar de agent).
hopos.init[]={"name":"display","driver":"hop","artifacts":[{"url":"https://github.com/xinix00/hop-os-surf/releases/download/rolling-release/display.elf"}],"memory_limit":134217728,"ports":{"surf":7878,"http":80},"tags":{"sharegroup":"desktop"},"cpu_shares":1024}
hopos.init[]={"name":"launcher","driver":"hop","artifacts":[{"url":"https://github.com/xinix00/hop-os-surf/releases/download/rolling-release/launcher.elf"}],"memory_limit":67108864,"tags":{"sharegroup":"desktop"},"cpu_shares":1024,"env":{"HOPOS_APPS":""}}

# --- Catalogus: apps die de launcher kan starten -----------------------------
# Álle window-apps zitten in de "apps"-sharegroup: ze stapelen coöperatief op
# de OVERIGE cores, dus je kunt meer vensters openen dan de node cores heeft
# (het 8e venster is gewoon nóg een kooi op dezelfde pool). cpu_shares is de
# POOL-grootte, geen per-app quotum: 2048 = die pool bezit 2 hele cores (het
# eerste lid van de groep zet de maat, de rest joint gratis). Pas 'm aan het
# board aan; RAM blijft de eerlijke grens (geheugen wordt niet gepoold).
hopos.apps[]={"name":"clock","driver":"hop","artifacts":[{"url":"https://github.com/xinix00/hop-os-surf/releases/download/rolling-release/clock.elf"}],"memory_limit":67108864,"tags":{"sharegroup":"apps"},"cpu_shares":2048}
hopos.apps[]={"name":"calc","driver":"hop","artifacts":[{"url":"https://github.com/xinix00/hop-os-surf/releases/download/rolling-release/calc.elf"}],"memory_limit":67108864,"tags":{"sharegroup":"apps"},"cpu_shares":2048}
hopos.apps[]={"name":"browser","driver":"hop","artifacts":[{"url":"https://github.com/xinix00/hop-os-surf/releases/download/rolling-release/browser.elf"}],"memory_limit":134217728,"tags":{"sharegroup":"apps"},"cpu_shares":2048}
hopos.apps[]={"name":"taskman","driver":"hop","artifacts":[{"url":"https://github.com/xinix00/hop-os-surf/releases/download/rolling-release/taskman.elf"}],"memory_limit":67108864,"tags":{"sharegroup":"apps"},"cpu_shares":2048}
