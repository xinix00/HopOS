{
 "name": "stulp",
 "driver": "hop",
 "memory_limit": 50331648,
 "tags": {
  "sharegroup": "huis"
 },
 "ports": {
  "http": 80,
  "attach": 7000
 },
 "env": {
  "STULP_ATTACH_SECRET": "<STULP_ATTACH_SECRET>",
  "STULP_TOKEN": "<STULP_TOKEN>"
 },
 "artifacts": [
  {
   "url": "https://github.com/xinix00/stulp/releases/download/apps/stulp-arm64-tamago.elf",
