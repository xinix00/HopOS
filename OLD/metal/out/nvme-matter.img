    {
      "id": "com.stulp.unifi",
      "version": "1.0.0",
      "root": "",
      "enabled": false,
      "offered": true,
      "manifest": {
        "api": {
          "status": {
            "method": "POST",
            "path": "/status"
          },
          "test": {
            "method": "POST",
            "path": "/test"
          }
        },
        "author": {
          "name": "Stulp"
        },
        "category": [
          "security"
        ],
        "compatibility": "\u003e=1.0.0",
        "description": {
          "en": "Cameras, lights, sensors, chimes and relays from a UniFi Protect console",
          "nl": "Camera's, lampen, sensoren, gongs en relais van een UniFi Protect-console"
        },
        "drivers": [
          {
            "capabilities": [
              "alarm_motion"
            ],
            "class": "camera",
            "id": "camera",
            "name": {
              "en": "Camera",
              "nl": "Camera"
            },
            "pair": [
              {
                "id": "list_devices",
                "navigation": {
                  "next": "add_devices"
                },
                "template": "list_devices"
              },
              {
                "id": "add_devices",
                "template": "add_devices"
              }
            ],
            "settings": [
              {
                "id": "mic_volume",
                "label": {
                  "en": "Microphone volume",
                  "nl": "Microfoonvolume"
                },
