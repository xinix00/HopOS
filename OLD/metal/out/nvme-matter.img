    {
      "id": "com.stulp.spotify",
      "version": "1.0.0",
      "root": "",
      "enabled": false,
      "offered": true,
      "manifest": {
        "api": {
          "authorize": {
            "method": "POST",
            "path": "/authorize"
          },
          "check": {
            "method": "POST",
            "path": "/check"
          },
          "disconnect": {
            "method": "POST",
            "path": "/disconnect"
          },
          "exchange": {
            "method": "POST",
            "path": "/exchange"
          },
          "status": {
            "method": "POST",
            "path": "/status"
          }
        },
        "author": {
          "name": "Stulp"
        },
        "capabilities": {
          "speaker_next": {
            "getable": false,
            "setable": true,
            "title": {
              "en": "Next",
              "nl": "Volgende"
            },
            "type": "boolean"
          },
          "speaker_prev": {
            "getable": false,
            "setable": true,
            "title": {
              "en": "Previous",
              "nl": "Vorige"
            },
            "type": "boolean"
          }
        },
        "category": [
          "music"
        ],
        "compatibility": "\u003e=12.0.0",
        "description": {
          "en": "Play a track on a Spotify Connect device, and control what is playing.",
          "nl": "Speel een nummer af op een Spotify Connect-apparaat, en bedien wat er speelt."
        },
        "drivers": [
          {
            "capabilities": [
              "speaker_playing",
              "speaker_prev",
              "speaker_next",
              "speaker_track",
              "speaker_artist",
              "speaker_album",
              "volume_set"
            ],
            "class": "speaker",
            "id": "player",
            "name": {
              "en": "Spotify Connect player",
              "nl": "Spotify Connect-speler"
            },
            "pair": [
              {
                "id": "list_devices",
                "navigation": {
                  "next": "add_devices"
                },
                "template": "list_devices"
              },
              {
                "id": "add_devices",
                "template": "add_devices"
              }
            ]
          }
        ],
        "flow": {
          "actions": [
            {
              "args": [
                {
                  "filter": "driver_id=player",
                  "name": "device",
                  "type": "device"
                },
                {
                  "name": "track",
                  "placeholder": {
                    "en": "Search for a track…",
                    "nl": "Zoek een nummer…"
                  },
                  "title": {
                    "en": "Track",
                    "nl": "Nummer"
                  },
                  "type": "autocomplete"
                }
              ],
              "hint": {
                "en": "Searches Spotify while you type. Remote control requires Spotify Premium.",
                "nl": "Zoekt bij Spotify terwijl je typt. Bedienen op afstand vraagt Spotify Premium."
              },
              "id": "play_track",
              "title": {
                "en": "Play a track",
                "nl": "Speel een nummer af"
              },
              "titleFormatted": {
                "en": "Play [[track]]",
                "nl": "Speel [[track]] af"
              }
            }
          ]
        },
        "id": "com.stulp.spotify",
        "name": {
          "en": "Spotify",
          "nl": "Spotify"
        },
        "sdk": 3,
        "ui": {
          "assets": [
            "settings/index.html",
            "settings/page.js"
          ]
        },
        "version": "1.0.0"
      },
      "installedAt": "2026-08-18T16:51:36.154938706Z",
      "updatedAt": "2026-08-18T16:51:36.154938706Z"
