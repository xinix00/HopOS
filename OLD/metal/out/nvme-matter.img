    {
      "id": "com.stulp.notify",
      "version": "1.0.0",
      "root": "",
      "enabled": false,
      "offered": true,
      "manifest": {
        "author": {
          "name": "Stulp"
        },
        "category": [
          "tools"
        ],
        "compatibility": "\u003e=1.0.0",
        "description": {
          "en": "Your phone or browser as a device, so a Flow can send a notification to it",
          "nl": "Je telefoon of browser als apparaat, zodat een Flow er een melding naartoe kan sturen"
        },
        "drivers": [
          {
            "capabilities": [
              "onoff"
            ],
            "capabilitiesOptions": {
              "onoff": {
                "title": {
                  "en": "Notifications",
                  "nl": "Meldingen"
                }
              }
            },
            "class": "phone",
            "id": "phone",
            "name": {
              "en": "Phone or browser",
              "nl": "Telefoon of browser"
            },
            "pair": [
              {
                "id": "subscribe",
                "template": "push_subscription"
              }
            ]
          }
        ],
        "flow": {
          "actions": [
            {
              "args": [
                {
                  "filter": "driver_id=phone",
                  "name": "device",
                  "type": "device"
                },
                {
                  "name": "title",
                  "optional": true,
                  "placeholder": {
                    "en": "Stulp",
                    "nl": "Stulp"
                  },
                  "title": {
                    "en": "Heading",
                    "nl": "Kop"
                  },
                  "type": "text"
                },
                {
                  "name": "message",
                  "placeholder": {
                    "en": "Someone is at the door",
                    "nl": "Iemand belt aan"
                  },
                  "title": {
                    "en": "Message",
                    "nl": "Bericht"
                  },
                  "type": "text"
                },
                {
                  "name": "image",
                  "optional": true,
                  "placeholder": {
                    "en": "No picture",
                    "nl": "Geen foto"
                  },
                  "title": {
                    "en": "Picture",
                    "nl": "Foto"
                  },
                  "type": "autocomplete"
                }
              ],
              "hint": {
                "en": "Arrives on that phone even when nobody has Stulp open. A picture is optional and comes from a camera that offers one; Android shows it, Safari does not.",
                "nl": "Komt op die telefoon aan, ook als niemand Stulp open heeft. Een foto is optioneel en komt van een camera die er een levert; Android toont hem, Safari niet."
              },
              "id": "send",
              "title": {
                "en": "Send a notification",
                "nl": "Stuur een melding"
              },
              "titleFormatted": {
                "en": "Send [[message]] to [[device]]",
                "nl": "Stuur [[message]] naar [[device]]"
              }
            }
          ]
        },
        "id": "com.stulp.notify",
        "name": {
          "en": "Notifications",
          "nl": "Meldingen"
        },
        "sdk": 3,
        "version": "1.0.0"
      },
      "installedAt": "2026-08-18T16:51:08.712710706Z",
      "updatedAt": "2026-08-18T16:51:08.712710706Z"
    },
